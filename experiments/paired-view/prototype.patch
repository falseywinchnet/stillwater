+
+// Two simultaneous projection phases, resolved in the existing display-color convention.
+kernel void paired_resolve(texture2d<float,access::read> first [[texture(0)]],
+ texture2d<float,access::read> second [[texture(1)]],
+ texture2d<float,access::write> result [[texture(2)]],uint2 pixel [[thread_position_in_grid]]) {
+    if(pixel.x>=result.get_width() || pixel.y>=result.get_height())return;
+    result.write(float4((first.read(pixel).rgb+second.read(pixel).rgb)*0.5f,1),pixel);
+}
